# MongoDB Database
MONGODB_URI=mongodb://[username]:[password]@[cluster].mongodb.net/nutrivkart?retryWrites=true&w=majority

# Authentication
# NEXTAUTH_URL is optional on Vercel (Vercel automatically handles it)
# NEXTAUTH_URL=https://your-vercel-domain.vercel.app
NEXTAUTH_SECRET=your_secure_random_string_here

# Cloudinary Integration (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Integration (Payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Upstash Redis / Vercel KV (Rate Limiting)
# If you enable Vercel KV in the Vercel Dashboard, these will be injected automatically
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# SMTP Email Configuration (Contact Forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=your_support_email@gmail.com
